<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/refrescar"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Empleado: búsqueda por número de cuenta -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaBusqueda"
                style="@style/Tarjeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/TituloSeccion"
                        android:text="@string/mov_buscar_titulo"
                        android:textSize="16sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCuenta"
                        style="@style/Campo"
                        android:layout_marginTop="12dp"
                        android:hint="@string/op_cuenta"
                        app:helperText="@string/login_ayuda_cuenta"
                        app:startIconDrawable="@drawable/ic_tarjeta">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/txtCuenta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionSearch"
                            android:inputType="number"
                            android:maxLength="8"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConsultar"
                        style="@style/BotonPrimario"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/mov_consultar"
                        android:textSize="16sp"
                        app:icon="@drawable/ic_buscar"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/lblError"
                style="@style/AvisoError"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/panelCargando"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="40dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:indeterminate="true"
                    app:indicatorColor="@color/eureka_primario" />

                <TextView
                    style="@style/TextoSecundario"
                    android:layout_marginTop="12dp"
                    android:text="@string/mov_cargando" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelInicial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/circulo_fondo"
                    android:importantForAccessibility="no"
                    android:padding="20dp"
                    android:src="@drawable/ic_recibo"
                    app:tint="@color/eureka_primario" />

                <TextView
                    style="@style/TextoSecundario"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/mov_inicial"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/panelResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Tarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/CirculoIcono"
                                android:src="@drawable/ic_tarjeta"
                                app:tint="@color/eureka_primario" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Etiqueta"
                                    android:text="@string/inicio_cuenta_ahorros" />

                                <TextView
                                    android:id="@+id/lblNumero"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:letterSpacing="0.04"
                                    android:textColor="@color/texto_oscuro"
                                    android:textSize="20sp" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/lblEstado"
                                style="@style/Pastilla" />
                        </LinearLayout>

                        <TextView
                            style="@style/Etiqueta"
                            android:layout_marginTop="16dp"
                            android:text="@string/mov_titular" />

                        <TextView
                            android:id="@+id/lblTitular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/texto_oscuro"
                            android:textSize="16sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="16dp"
                            android:background="@color/borde_tarjeta" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Etiqueta"
                                    android:text="@string/mov_saldo" />

                                <TextView
                                    android:id="@+id/lblSaldo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="sans-serif-medium"
                                    android:textColor="@color/eureka_primario"
                                    android:textSize="22sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Etiqueta"
                                    android:text="@string/mov_moneda" />

                                <TextView
                                    android:id="@+id/lblMoneda"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/texto_oscuro"
                                    android:textSize="16sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TituloSeccion"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/mov_titulo_lista" />

                    <TextView
                        android:id="@+id/lblCantidad"
                        style="@style/TextoSecundario" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Tarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/listaMovimientos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:nestedScrollingEnabled="false" />

                        <TextView
                            android:id="@+id/lblVacio"
                            style="@style/TextoSecundario"
                            android:drawableTop="@drawable/mike_vacio"
                            android:drawablePadding="12dp"
                            android:layout_width="match_parent"
                            android:gravity="center"
                            android:padding="28dp"
                            android:text="@string/mov_vacio"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
